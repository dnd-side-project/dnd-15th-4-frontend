{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 80,
  "arrowParens": "always",
  "sortPackageJson": false,
  "sortTailwindcss": {},
  "ignorePatterns": [
    ".next/**",
    "out/**",
    "build/**",
    "storybook-static/**",
    "pnpm-lock.yaml"
  ]
}
